        "\n",
        "# Calculate mean hf1_che per income group (drop NaN/Not classified)\n",
        "order = ['Low income', 'Lower middle income', 'Upper middle income', 'High income']\n",
        "avg = (\n",
        "    df[df['income_group'].isin(order)]\n",
        "    .groupby('income_group')['hf1_che']\n",
        "    .mean()\n",
        "    .reindex(order)\n",
        ")\n",
        "\n",
        "# Plot\n",
        "fig, ax = plt.subplots(figsize=(9, 6))\n",
        "\n",
        "colors = ['#d73027', '#fc8d59', '#91bfdb', '#4575b4']\n",
        "bars = ax.bar(avg.index, avg.values, color=colors, edgecolor='white', width=0.6)\n",
        "\n",
        "# Add value labels on top of each bar\n",
        "for bar, val in zip(bars, avg.values):\n",
        "    ax.text(bar.get_x() + bar.get_width() / 2, val + 0.5,\n",
        "            f'{val:.1f}%', ha='center', va='bottom', fontsize=11, fontweight='bold')\n",
        "\n",
        "ax.set_xlabel('Income Group', fontsize=12)\n",
        "ax.set_ylabel('Mean hf1 (% of Current Health Expenditure)', fontsize=12)\n",
        "ax.set_title('Govt & Compulsory Health Financing (hf1)\\nby Income Group', fontsize=14)\n",
        "ax.set_ylim(0, avg.max() * 1.15)\n",
        "ax.tick_params(axis='x', labelsize=10)\n",
        "ax.grid(axis='y', linestyle='--', alpha=0.5)\n",
        "\n",
        "\n"
